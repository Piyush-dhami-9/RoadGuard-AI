POSTGRES_USER=roadguard
POSTGRES_PASSWORD=roadguard
POSTGRES_DB=roadguard
DATABASE_URL=postgresql+asyncpg://roadguard:roadguard@db:5432/roadguard
CORS_ORIGINS=http://localhost:5173
# development | production. Production never falls back to demo output.
APP_ENV=development
# demo: labelled placeholder detector, not AI.
# yolo: trained YOLO11 detection weights at MODEL_WEIGHTS are required; never replaced by demo output.
# auto: yolo when the weights file exists, otherwise demo (development) or unavailable (production).
INFERENCE_MODE=auto
# Trained YOLO11 detection weights. Keep this a relative path under model/weights/: Docker Compose mounts that
# folder at the same relative location in the container, so one value works on the host and in Docker.
MODEL_WEIGHTS=model/weights/roadguard-yolo11-rdd2022.pt
# Docker only: true builds the backend image with PyTorch (CPU) and Ultralytics, required for INFERENCE_MODE=yolo.
INSTALL_MODEL_DEPS=false
# auto (CUDA, then Apple MPS, then CPU) | cpu | mps | cuda:0. Containers have no GPU here: leave auto or use cpu.
INFERENCE_DEVICE=auto
# Detections below this confidence (0 to 1) are discarded.
CONFIDENCE_THRESHOLD=0.25
INFERENCE_IMAGE_SIZE=640
# Keep in step with client_max_body_size in frontend/default.conf.template
MAX_UPLOAD_MB=10
MAX_IMAGE_MEGAPIXELS=50
