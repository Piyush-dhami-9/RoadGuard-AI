POSTGRES_USER=roadguard
POSTGRES_PASSWORD=roadguard
POSTGRES_DB=roadguard
DATABASE_URL=postgresql+asyncpg://roadguard:roadguard@db:5432/roadguard
CORS_ORIGINS=http://localhost:5173
MODEL_WEIGHTS=model/weights/best.pt
# development | production. Production never falls back to demo output.
APP_ENV=development
# auto (demo when no weights exist, development only) | demo | trained
INFERENCE_MODE=auto
# Keep in step with client_max_body_size in frontend/default.conf.template
MAX_UPLOAD_MB=10
MAX_IMAGE_MEGAPIXELS=50
