server {
  listen 80;
  root /usr/share/nginx/html;
  index index.html;

  # Resolve the API upstream at request time. A build-time upstream would stop
  # nginx from starting wherever that host does not exist, such as Container
  # Apps, where the API is a separate app rather than a compose service.
  resolver ${NGINX_RESOLVERS} ipv6=off valid=10s;

  # Must stay in step with the API's MAX_UPLOAD_MB (10 MB file + multipart framing).
  client_max_body_size 11m;

  location / {
    try_files $uri /index.html;
  }

  location /api/ {
    set $api_upstream "${BACKEND_ORIGIN}";
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass $api_upstream;
    # Host is left as the upstream's own hostname: routing in front of the API
    # may select the app by Host, and TLS upstreams need a matching SNI name.
    proxy_ssl_server_name on;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
